<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>AurumConect</AssemblyName>
    <RootNamespace>AurumConect</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Taller del Joyero</Company>
    <Product>AURUM CONECT</Product>
    <Description>Panel de conexión entre Rhino 7 / MatrixGold 3.1 y AURUM Render.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1020.30" />
    <PackageReference Include="RhinoCommon" Version="7.27.23032.13001">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Eto.Forms" Version="2.7.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
