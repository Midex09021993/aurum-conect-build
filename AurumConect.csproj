<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>AurumConect</AssemblyName>
    <RootNamespace>AurumConect</RootNamespace>
    <Version>1.0.7</Version>
    <Company>Taller del Joyero</Company>
    <Product>AURUM CONECT</Product>
    <Description>Panel de conexión entre Rhino 7 / MatrixGold 3.1 y AURUM Render.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1020.30" GeneratePathProperty="true" />
    <PackageReference Include="RhinoCommon" Version="7.27.23032.13001">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Eto.Forms" Version="2.7.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\\lib\\net45\\Microsoft.Web.WebView2.Core.dll"
                      LogicalName="AurumConect.Embedded.Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\\runtimes\\win-x64\\native\\WebView2Loader.dll"
                      LogicalName="AurumConect.Embedded.WebView2Loader.dll" />
  </ItemGroup>
  <Target Name="ValidateEmbeddedWebView2Payload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PkgMicrosoft_Web_WebView2)\\lib\\net45\\Microsoft.Web.WebView2.Core.dll')" Text="No se encontró WebView2.Core para incrustar en el RHP." />
    <Error Condition="!Exists('$(PkgMicrosoft_Web_WebView2)\\runtimes\\win-x64\\native\\WebView2Loader.dll')" Text="No se encontró WebView2Loader x64 para incrustar en el RHP." />
  </Target>
</Project>